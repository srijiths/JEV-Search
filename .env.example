# Copy to `.env.local` and paste your own key. `.env.local` is gitignored.
#
# This variable is deliberately NOT prefixed with NEXT_PUBLIC_. Anything so prefixed is
# inlined into the browser bundle, which would hand your key to every visitor. It is read
# only inside src/app/api/search-intent/route.ts, which runs on the server.
OPENROUTER_API_KEY=

# Optional. Pins the Jev version used for classification.
# Defaults to typesafe/jev-1.13 — `typesafe/jev-latest` is not routable on OpenRouter and
# returns 404, so the version is pinned explicitly rather than tracking a moving alias.
# JEV_MODEL=typesafe/jev-1.13

# Optional. Which half of the system fills the closed-set filters: `hybrid` or `jev`.
#
#   hybrid (default) — 17 questions. Jev classifies the search and reads ambiguous
#                      phrasing; the parsers fill every filter. Cheapest, and exact for
#                      anything the text states literally.
#   jev              — 51 questions. Jev additionally decides home type, listing status,
#                      stories, garage and bed/bath buckets, the listing toggles and the
#                      feature checkboxes, for the phrasings no literal covers.
#
# Numbers and free text are parsed in BOTH modes. That is not an unfinished feature: Jev
# answers with a label, a probability or a score, so no setting can make it return a price
# or a street address. See src/lib/filters/fields.ts.
#
# Overridable per request (`{ text, mode }`), which is what the debug panel's toggle does.
# EXTRACTION_MODE=hybrid
